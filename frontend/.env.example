# FakeProof Labs Frontend Environment Configuration
# Copy this file to .env and update values for your deployment

# Backend API Base URL
# Required for production deployments (Vercel, Render, etc)
# Example for localhost development: http://localhost:8000
# Example for Render backend: https://deepfake-detector-backend.onrender.com
# Example for custom domain: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
