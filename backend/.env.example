# Example environment variables for FakeProof Labs Backend
# Copy to backend/.env and fill with real values. DO NOT commit secrets.

# Google Gemini API key (Required for AI explanations, optional for core CNN predictions)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ENABLED="True"

# Label mapping: set to False for canonical mapping (score>0.5 -> Real)
INVERT_LABELS="False"

# Confidence threshold (0.0 to 1.0, default 0.5)
CONFIDENCE_THRESHOLD="0.5"

# Comma-separated allowed frontend production URLs for CORS (e.g. Vercel deployment URL)
# Example: https://fakeproof-labs.vercel.app,https://your-preview.vercel.app
PRODUCTION_FRONTEND_URLS=""

